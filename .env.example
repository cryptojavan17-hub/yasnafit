# ─── Yasnafit — نمونه متغیرهای محیطی ───
# این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید (.env هرگز به Git نمی‌رود).

# سرور
PORT=3020
# YASNAFIT_HOST=127.0.0.1

# ─── تلگرام (همه اختیاری — بدون آن‌ها برنامه عادی کار می‌کند) ───
# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=
# یوزرنیم ربات بدون @ (برای ساخت لینک اتصال)
TELEGRAM_BOT_USERNAME=
# رمز مخفی وب‌هوک (رشتهٔ تصادفی قوی؛ هدر X-Telegram-Bot-Api-Secret-Token با آن سنجیده می‌شود)
# تولید پیشنهادی: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# آدرس عمومی پورتال شاگرد (برای دکمه‌های «مشاهده برنامه» در تلگرام) — مثال:
YASNAFIT_PUBLIC_URL=https://yasnafit-production.up.railway.app
# فقط توسعهٔ محلی بدون HTTPS: دریافت آپدیت‌ها با long-polling به‌جای وب‌هوک
# TELEGRAM_POLLING=1
