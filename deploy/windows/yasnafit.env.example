# Yasnafit — نمونهٔ متغیرهای محیطی کیت ویندوز
# این فایل را ویرایش نکنید. deploy/update اگر yasnafit.env کنار اسکریپت نباشد، از روی همین نمونه می‌سازد.
# yasnafit.env در Git نمی‌رود. هیچ توکن/رمز واقعی اینجا نگذارید.
# خط خالی بعد از = یعنی «تنظیم نشد» (متغیر پاک می‌شود، نه رشتهٔ خالی).
# اگر PORT اینجا مقدار داشته باشد، بر آرگومان -Port مقدم است.
# فایل را UTF-8 ذخیره کنید.

# سرور
PORT=3020
# فقط اگر نمی‌خواهید از شبکهٔ محلی دیده شود:
# YASNAFIT_HOST=127.0.0.1

# تلگرام — اختیاری. می‌توانید به‌جای این فایل از پنل مربی تنظیم کنید:
# سیستم ← تنظیمات تلگرام. اگر متغیر محیطی مقدار داشته باشد، اولویت با همان است.
# توکن را فقط در یک محیط بگذارید (یا ویندوز، یا Railway) وگرنه ربات خطای 409 می‌دهد.
# مقدار توکن/رمز اینجا خالی است و هرگز در گزارش چاپ نمی‌شود.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# آدرس عمومی برای دکمه‌های تلگرام. مثال بدون رمز: https://yasnafit.ir
YASNAFIT_PUBLIC_URL=
# فقط توسعهٔ محلی بدون HTTPS:
# TELEGRAM_POLLING=1

# پروداکشن پشت پروکسی — روی ویندوز خانگی لازم نیست
# NODE_ENV=production
# YASNAFIT_TRUST_PROXY=1
# YASNAFIT_COOKIE_SECURE=1
